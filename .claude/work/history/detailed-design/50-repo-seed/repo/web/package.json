{
  "name": "scp-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.21.0 || ^26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "gen": "pnpm gen:api && pnpm gen:routes && pnpm extract",
    "gen:api": "redocly bundle ../api/openapi.yaml -o ../internal/apispec/openapi.bundled.yaml && redocly bundle ../api/openapi.admin.yaml -o ../internal/apispec/openapi.admin.bundled.yaml && openapi-typescript ../internal/apispec/openapi.admin.bundled.yaml -o src/lib/api/schema.d.ts",
    "gen:routes": "vite build --outDir .build/routes-gen --emptyOutDir",
    "api:lint": "redocly lint ../api/openapi.yaml ../api/openapi.admin.yaml",
    "api:bundle-check": "node scripts/bundle-check.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "build": "vite build && node scripts/finalize.ts && node scripts/precompress.ts && node scripts/verify-dist.ts && node scripts/budget.ts",
    "extract": "lingui extract --clean",
    "test": "vitest run --project unit --project tooling",
    "test:browser": "vitest run --project browser",
    "e2e": "playwright test",
    "check-pins": "node scripts/check-pins.ts",
    "budget": "node scripts/budget.ts",
    "size": "node scripts/budget.ts",
    "check": "pnpm check-pins && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@primer/octicons-react": "19.39.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-table": "9.2.6",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "8.0.6",
    "@eslint/js": "10.0.1",
    "@lingui/babel-plugin-lingui-macro": "6.9.0",
    "@lingui/cli": "6.9.0",
    "@lingui/format-po": "6.9.0",
    "@lingui/vite-plugin": "6.9.0",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.59.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/trusted-types": "2.0.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-lingui": "0.16.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "msw": "3.0.2",
    "openapi-msw": "2.1.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.21.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  }
}
