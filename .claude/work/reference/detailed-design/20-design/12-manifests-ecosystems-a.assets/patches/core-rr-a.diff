+// stampPaths fills the empty Location.Path of parser diagnostics and locked components with the path of the file they were parsed from
+// (ADDED by unit 12, RR-A7). Parsers cannot know their path (output is cached by blob SHA), and assemblers merge diagnostics of several files into
+// one unit, so only the runner knows which file a value came from. The slices are copied first: Parsed values come from a shared cache.
+func stampPaths(p *Parsed) {
+	if p.File.Path == "" {
+		return
+	}
+	p.Diagnostics = slices.Clone(p.Diagnostics)
+	for i := range p.Diagnostics {
+		if p.Diagnostics[i].Loc.Path == "" {
+			p.Diagnostics[i].Loc.Path = p.File.Path
+		}
+	}
+	p.Locked = slices.Clone(p.Locked)
+	for i := range p.Locked {
+		if p.Locked[i].Loc.Path == "" {
+			p.Locked[i].Loc.Path = p.File.Path
+		}
+	}
