+// Clone returns d with a private copy of Extra (ADDED by unit 12, RR-A5). Assemblers that change a dependency they received in a Parsed must
+// clone it first: Parsed values are cached and shared, and the setters write through the Extra pointer.
+func (d Dependency) Clone() Dependency {
+	if d.Extra != nil {
+		x := *d.Extra
+		d.Extra = &x
+	}
+	return d
+}
