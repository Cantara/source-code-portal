{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "vite.plugins.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "lingui.config.ts",
    "eslint.config.js",
    "scripts",
    "e2e"
  ]
}
