{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Patch, minor, digest and pin updates merge themselves once CI is green; major updates wait for a person to review and merge the PR",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests", ":semanticCommitTypeAll(chore)"],
  "timezone": "Europe/Oslo",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "7 days",
  "ignorePaths": [".claude/**"],
  "postUpdateOptions": ["gomodTidy"],
  "labels": ["dependencies"],
  "automergeType": "pr",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "description": "Patch, minor, digest and pin updates of the Go server, the web UI, the images, the actions and the tools merge themselves when every check passes",
      "matchUpdateTypes": ["patch", "minor", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Major updates open a PR for manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "The go directive of go.mod follows the toolchain release",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "One toolchain update: the Go image with go.mod",
      "matchPackageNames": ["go", "golang"],
      "groupName": "go toolchain"
    },
    {
      "description": "One toolchain update: the Node image with web/.node-version",
      "matchPackageNames": ["node"],
      "groupName": "node toolchain"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions in the Makefile and CI",
      "managerFilePatterns": ["/^Makefile$/", "/^\\.github/workflows/ci\\.yml$/", "/^deploy/Dockerfile$/"],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION := (?<currentValue>\\S+)",
        "golangci-lint-action@\\S+ # \\S+\\n\\s+with:\\n\\s+version: v(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "pnpm version in CI, the Dockerfile and package.json",
      "managerFilePatterns": ["/^\\.github/workflows/(ci|release)\\.yml$/", "/^deploy/Dockerfile$/"],
      "matchStrings": ["PNPM_VERSION[:=] ?(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "GoReleaser version in the release workflow",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["GORELEASER_VERSION: (?<currentValue>v\\S+)"],
      "depNameTemplate": "goreleaser/goreleaser",
      "datasourceTemplate": "github-releases"
    }
  ]
}
