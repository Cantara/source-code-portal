# Release image: the final stage of deploy/Dockerfile around the binary GoReleaser built and the web bundle release.yml built, so the
# bytes in the image are the bytes in the signed archives. GoReleaser's dockers_v2 lays the build context out as <os>/<arch>/scp
# ($TARGETPLATFORM selects the binary) plus the extra file web/bundle.
FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:9eeb7f5887d0e239e78264b06f7f11d2e14be534050481803a9e4728fcdd278e
ARG BUILD_ID=dev
ARG VERSION=dev
LABEL org.opencontainers.image.title="Source Code Portal" \
      org.opencontainers.image.description="Organisational dashboard for GitHub repositories" \
      org.opencontainers.image.source="https://github.com/Cantara/source-code-portal" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${BUILD_ID}"
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/scp /scp
COPY web/bundle /web
ENV SCP_WEB_DIR=/web SCP_WEB_NODE=/nodejs/bin/node
# /data is the one writable path (the SQLite file). distroless has no shell, so the directory is created by copying a file into it.
COPY --chown=65532:65532 <<EOF /data/.keep
EOF
USER 65532:65532
WORKDIR /data
EXPOSE 9090 9091
VOLUME ["/data"]
ENTRYPOINT ["/scp"]
CMD ["serve"]
