#!/bin/sh
# The quick checks of the gate on what is staged: gofmt for Go files, Prettier for the web's files. The full gate is `make check`.
# Switched on once per clone with `make hooks`. Skip for one commit with `git commit --no-verify`.
set -eu
cd "$(git rev-parse --show-toplevel)"

scripts/check-neutral.sh staged

go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -n "$go_files" ]; then
	# shellcheck disable=SC2086
	bad=$(gofmt -l $go_files || true)
	if [ -n "$bad" ]; then
		echo "gofmt: these staged files are not formatted (run: gofmt -w <file>):" >&2
		echo "$bad" >&2
		exit 1
	fi
fi

web_files=$(git diff --cached --name-only --diff-filter=ACM -- 'web/*' | sed 's|^web/||' | grep -E '\.(ts|tsx|js|mjs|json|css|md)$' || true)
if [ -n "$web_files" ]; then
	if [ -x web/node_modules/.bin/prettier ]; then
		# shellcheck disable=SC2086
		(cd web && node_modules/.bin/prettier --check --ignore-unknown $web_files) || {
			echo "prettier: format the staged web files (run: pnpm -C web format)" >&2
			exit 1
		}
	else
		echo "pre-commit: web/node_modules is missing, Prettier skipped (run: pnpm -C web install)" >&2
	fi
fi
